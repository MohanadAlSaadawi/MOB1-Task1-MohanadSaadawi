<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/article_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:src="@drawable/ai_banner"
            android:scaleType="centerCrop"
            android:contentDescription="Artificial Intelligence Banner" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="The Future of Artificial Intelligence"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="@color/article_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:text="Artificial intelligence is transforming the world around us. From smart assistants to advanced medical systems, AI technology is helping people solve complex problems and improve everyday life."
            android:textSize="17sp"
            android:lineSpacingExtra="6dp"
            android:justificationMode="inter_word"
            android:textColor="@color/article_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:text="One of the most exciting developments in artificial intelligence is machine learning. Computers can now analyze large amounts of information, recognize patterns, and make predictions. These capabilities are being used in education, transportation, healthcare, and many other industries."
            android:textSize="17sp"
            android:lineSpacingExtra="6dp"
            android:justificationMode="inter_word"
            android:textColor="@color/article_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:text="Although artificial intelligence offers many benefits, it also creates important challenges. Developers must consider privacy, security, and responsible technology use. In the future, AI will continue to evolve and create new opportunities for people around the world."
            android:textSize="17sp"
            android:lineSpacingExtra="6dp"
            android:justificationMode="inter_word"
            android:textColor="@color/article_text" />

    </LinearLayout>

</ScrollView>
