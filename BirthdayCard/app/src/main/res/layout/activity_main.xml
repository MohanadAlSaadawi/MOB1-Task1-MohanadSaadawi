<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_background">

    <ImageView
        android:id="@+id/birthdayImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/birthday_bg"
        android:scaleType="centerCrop"
        android:contentDescription="Birthday decoration" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/image_overlay"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Happy Birthday, Omar!"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="@color/card_text"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wishing you a wonderful year filled with happiness and success!"
            android:textSize="22sp"
            android:gravity="center"
            android:textColor="@color/card_text"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="With love, Mohanad!"
            android:textSize="26sp"
            android:textStyle="italic"
            android:textColor="@color/card_accent" />

    </LinearLayout>

</FrameLayout>
